# Live Transcriber — environment configuration template
#
# Copy this file to .env and fill in your values:
#
#   cp .env.template .env
#
# .env is git-ignored and never committed.
# ---------------------------------------------------------

# ---- Logging -----------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# Logs are written to logs/live_transcriber.log (rotating, 5 MB × 3 files)
# and echoed to stderr.
LOG_LEVEL=INFO

# ---- Transcription API keys --------------------------------

# Deepgram API key (required when using the Deepgram engine)
DEEPGRAM_API_KEY=

# OpenAI API key (required when using the OpenAI engine or
# the Bible-reference LLM resolver)
OPENAI_API_KEY=

# ---- Bible reference resolver ------------------------------

# Set to false / 0 / no to disable the LLM resolver and fall
# back to the local regex detector only.
BIBLE_LLM_ENABLED=true

# OpenAI model used for Bible-reference extraction.
# Must support JSON mode (json_object response_format).
BIBLE_LLM_MODEL=gpt-4o-mini

# Minimum LLM confidence (0.0 – 1.0) required to accept a
# detected reference into the session history.
BIBLE_REFERENCE_CONFIDENCE_THRESHOLD=0.85

# Rolling transcript context window fed to the LLM (seconds).
BIBLE_CONTEXT_SECONDS=20.0

# Debounce delay (ms) before sending a candidate to the LLM.
# Rapid consecutive segments are batched into one call.
BIBLE_DEBOUNCE_MS=800
